---
/**
 * Hero.astro —— 首页顶部大字区
 * 出版物感：左上 eyebrow + 大衬线标题 + 副标题 + 印章红横线 + 一行"6 届"
 */
import { site, grades } from '../data/works.js';
---
<section class="hero">
  <div class="container">
    <p class="hero-eyebrow">{site.eyebrow}</p>
    <h1 class="hero-title">
      <span class="hero-title-main">{site.name}</span>
      <span class="hero-title-divider" aria-hidden="true"></span>
      <span class="hero-title-sub">{site.tagline}</span>
    </h1>
    <div class="hero-actions">
      <a href={`/g/${grades[0].id}`} class="btn">浏览全部作品</a>
      <a href="#about" class="hero-link">关于社团 →</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 96px;
    padding-bottom: 96px;
    border-bottom: 1px solid var(--border);
  }
  .hero-eyebrow {
    font-size: 11px;
    letter-spacing: var(--tracking-xwide);
    color: var(--text-faint);
    text-transform: uppercase;
    margin-bottom: 32px;
  }
  .hero-eyebrow::before {
    content: '';
    display: inline-block;
    width: 28px;
    height: 1px;
    background-color: var(--accent);
    vertical-align: middle;
    margin-right: 12px;
  }
  .hero-title {
    max-width: 22em;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .hero-title-main {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(48px, 9vw, 96px);
    letter-spacing: var(--tracking-cn);
    line-height: 1.15;
    color: var(--text);
  }
  .hero-title-divider {
    display: block;
    width: 72px;
    height: 3px;
    background-color: var(--accent);
    margin: 4px 0;
  }
  .hero-title-sub {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(18px, 2.4vw, 22px);
    color: var(--text-soft);
    letter-spacing: var(--tracking-cn);
    line-height: 1.6;
    max-width: 28em;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 56px;
    flex-wrap: wrap;
  }
  .hero-link {
    font-family: var(--font-serif);
    font-size: 15px;
    color: var(--text-soft);
    letter-spacing: var(--tracking-cn);
  }
  .hero-link:hover { color: var(--accent); }
  @media (max-width: 640px) {
    .hero { padding-top: 56px; padding-bottom: 56px; }
    .hero-actions { gap: 16px; margin-top: 36px; }
  }
</style>
