---
/**
 * WorkCard.astro —— 期页里的"单件作品"卡片（文稿 + 美术共用）
 * 文稿 type=text：点"展开全文"展开正文
 * 美术 type=art ：渲染 SVG 占位
 */
import ArtPlaceholder from './ArtPlaceholder.astro';

interface TextWork {
  type: 'text';
  slug: string;
  title: string;
  author: string;
  date: string;
  excerpt: string;
  body: string;
}

interface ArtWork {
  type: 'art';
  slug: string;
  title: string;
  author: string;
  date: string;
  svgName: string;
  caption: string;
}

type Work = TextWork | ArtWork;
interface Props {
  work: Work;
  index: number;
}

const { work, index } = Astro.props;
const panelId = `work-panel-${work.slug}-${index}`;
const paragraphs = (work.type === 'text' ? work.body : '').split(/\n\n+/);
---
<article class="work-card">
  <header class="work-head">
    <span class="work-tag">{work.type === 'text' ? '文稿' : '美术'}</span>
    <span class="work-head-meta">{work.author} · {work.date}</span>
  </header>

  <h3 class="work-title">{work.title}</h3>

  {work.type === 'art' ? (
    <div class="work-art">
      <ArtPlaceholder svgName={work.svgName} alt={work.title} ratio="16 / 10" />
      <figcaption class="work-caption">{work.caption}</figcaption>
    </div>
  ) : (
    <p class="work-excerpt">{work.excerpt}</p>
  )}

  {work.type === 'text' && (
    <div class="work-expand">
      <button
        type="button"
        class="work-toggle"
        data-work-toggle
        aria-expanded="false"
        aria-controls={panelId}
      >
        <span class="work-toggle-label">展开全文</span>
        <span class="work-toggle-mark" aria-hidden="true">+</span>
      </button>
      <div
        class="work-body"
        id={panelId}
        role="region"
        aria-label={`${work.title} 正文`}
      >
        <div class="prose work-body-inner">
          {paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  )}
</article>

<style>
  .work-card {
    padding: 30px 28px 32px;
    background-color: var(--bg-soft);
    border: 1px solid var(--border);
    transition: border-color var(--dur-hover) var(--ease);
  }
  .work-card:hover { border-color: var(--border-hover); }

  .work-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .work-tag {
    display: inline-block;
    padding: 3px 9px;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: 11px;
    letter-spacing: 0.18em;
    line-height: 1.4;
  }

  .work-head-meta {
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--text-faint);
  }

  .work-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 24px;
    line-height: 1.45;
    letter-spacing: var(--tracking-cn);
    color: var(--text);
    margin-bottom: 14px;
  }

  .work-excerpt {
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 1.9;
    color: var(--text-soft);
    letter-spacing: var(--tracking-cn);
    padding-left: 14px;
    border-left: 2px solid var(--border-hover);
  }

  .work-art { margin: 18px 0 4px; }
  .work-caption {
    margin-top: 12px;
    font-size: 12.5px;
    color: var(--text-faint);
    letter-spacing: 0.04em;
    line-height: 1.7;
  }

  /* 展开按钮 */
  .work-expand { margin-top: 22px; }
  .work-toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    background: transparent;
    border: 0;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 13px;
    letter-spacing: 0.12em;
    color: var(--text-soft);
    transition: color var(--dur-hover) var(--ease);
  }
  .work-toggle:hover { color: var(--accent); }
  .work-toggle-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 12px;
    line-height: 1;
    transition: transform var(--dur-hover) var(--ease);
  }
  .work-toggle[aria-expanded='true'] .work-toggle-mark {
    transform: rotate(45deg);
  }

  /* 折叠正文 */
  .work-body {
    max-height: 0;
    overflow: hidden;
    visibility: hidden;
    transition:
      max-height 0.45s var(--ease),
      visibility 0s linear 0.45s,
      margin-top 0.45s var(--ease);
  }
  .work-body.is-open {
    max-height: 4000px;
    visibility: visible;
    margin-top: 18px;
    transition:
      max-height 0.45s var(--ease),
      visibility 0s linear 0s,
      margin-top 0.45s var(--ease);
  }
  .work-body-inner {
    padding-top: 18px;
    border-top: 1px dashed var(--border);
  }
</style>
